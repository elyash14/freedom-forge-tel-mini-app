// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AppConfig {
  id        String   @id @default("default")
  updatedAt DateTime @updatedAt
}

model HistoricalReturn {
  year           Int    @id
  inflation      Float
  stockMarket    Float  @map("stock_market")
  gold           Float
  bankDeposit    Float  @map("bank_deposit")
  investmentFund Float  @map("investment_fund")
  crypto         Float?
  dollar         Float  @default(0)

  @@map("historical_returns")
}

model AssetClass {
  id        String   @id @default(cuid())
  key       String   @unique
  labelFa   String
  labelEn   String
  color     String   @default("#6C9BCF")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id               String            @id @default(cuid())
  telegramId       BigInt            @unique
  username         String?
  firstName        String?
  lastName         String?
  locale           String            @default("fa")
  selectedPlanId   String?
  selectedPlan     FreedomPlan?      @relation("SelectedPlan", fields: [selectedPlanId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  freedomPlans      FreedomPlan[]      @relation("UserPlans")
  customPortfolios  CustomPortfolio[]
  externalHoldings  ExternalHolding[]
}

model ExternalHolding {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetKey   String
  name       String
  totalValue Float    @default(0)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, assetKey])
  @@index([userId])
}

model CustomPortfolio {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  annualReturnRate Float
  color            String   @default("#B794F6")
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model FreedomPlan {
  id                  String         @id @default(cuid())
  userId              String?
  user                User?          @relation("UserPlans", fields: [userId], references: [id], onDelete: SetNull)
  sessionId           String         @default("")
  locale              String         @default("fa")
  monthlyExpense      Float
  initialCapital      Float
  assetCapitals       Json           @default("{}")
  portfolioAllocation Json
  nominalReturnRate   Float
  realReturnRate      Float
  monthlyContribution Float
  targetCapital       Float
  yearsToFreedom      Float
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  progressRecords     PlanProgress[]
  selectedByUsers     User[]         @relation("SelectedPlan")

  @@index([sessionId])
  @@index([userId])
}

model PlanProgress {
  id           String      @id @default(cuid())
  planId       String
  plan         FreedomPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  year         Int
  month        Int
  contribution Float
  totalValue   Float
  assetDetails Json?       @default("{}")
  date         DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([planId, year, month])
  @@index([planId])
}
