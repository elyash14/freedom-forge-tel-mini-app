// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AppConfig {
  id        String   @id @default("default")
  updatedAt DateTime @updatedAt
}

model HistoricalReturn {
  year           Int    @id
  inflation      Float
  stockMarket    Float  @map("stock_market")
  gold           Float
  bankDeposit    Float  @map("bank_deposit")
  investmentFund Float  @map("investment_fund")
  crypto         Float?

  @@map("historical_returns")
}

model AssetClass {
  id        String   @id @default(cuid())
  key       String   @unique
  labelFa   String
  labelEn   String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String        @id @default(cuid())
  telegramId   BigInt?       @unique
  locale       String        @default("fa")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  freedomPlans FreedomPlan[]
}

model FreedomPlan {
  id                  String   @id @default(cuid())
  userId              String?
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId           String
  locale              String   @default("fa")
  monthlyExpense      Float
  initialCapital      Float
  portfolioAllocation Json
  nominalReturnRate   Float
  realReturnRate      Float
  monthlyContribution Float
  targetCapital       Float
  yearsToFreedom      Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([sessionId])
  @@index([userId])
}
